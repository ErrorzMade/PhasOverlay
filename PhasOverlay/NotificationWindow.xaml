<Window x:Class="PhasOverlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhasOverlay Notification"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="0" Top="0">

    <!-- Margin gives the drop shadow room to render inside the transparent window. -->
    <Border x:Name="NotificationPopup" Visibility="Collapsed" Opacity="0" Margin="24"
            Background="#F2141416" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
            CornerRadius="10" Padding="0" IsHitTestVisible="False" Effect="{StaticResource PanelShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="NotifTranslate" X="-20"/>
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal">
            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="9,0,0,9"/>
            <TextBlock x:Name="NotificationText" Foreground="White" FontSize="18" FontWeight="Bold"
                       TextAlignment="Center" VerticalAlignment="Center" Margin="16,12,22,12"/>
        </StackPanel>
    </Border>
</Window>
