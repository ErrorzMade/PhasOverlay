<Window x:Class="PhasOverlay.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to PhasOverlay" Height="665" Width="640"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BgBorder" Width="36" Height="20" CornerRadius="10" Background="#FF2A2A2E" HorizontalAlignment="Left"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FFAAAAAA" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FF3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FFB455FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF151515"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="19,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FF2A2A2E"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFAAAAAA"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#FF3F3F46" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3E3E42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFB455FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent primary CTA -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF151515"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFC581FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF9B45E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFB455FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small keyboard cap for the cheat sheet -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#FF1C1C1F"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2111112" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Margin="12" Effect="{StaticResource PanelShadow}">
        <Grid Margin="34,30,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="PhasOverlay" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StepSubtitle" Text="WELCOME" Foreground="#FFB455FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Border Height="3" Width="60" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Center" Background="{StaticResource AccentUnderline}"/>
            </StackPanel>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="0,26,0,0">

                <!-- STEP 1: WELCOME -->
                <StackPanel x:Name="Step1" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="👻" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="White"/>
                    <TextBlock Text="Your investigation companion" Foreground="White" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock
                               Foreground="#FFCCCCCC" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" MaxWidth="470" HorizontalAlignment="Center" Height="70"><Run Text="PhasOverlay allows you to track hunts, cooldowns, ghost speeds and more to give you a leg up in your investigation. With a robust evidence system, you can identify ghosts quickly and"/><Run Language="en-gb" Text=" stay on top of the ghost."/><LineBreak/><Run Language="en-gb"/></TextBlock>

                    <Button Content="GET STARTED" Width="200" Height="46" Margin="0,34,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="NextStep_Click"/>
                    <Button Content="Skip setup" Style="{StaticResource SkipButtonStyle}" Margin="0,14,0,0" Click="Skip_Click"/>

                    <Border Background="#FF161618" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,26,0,0" MaxWidth="480" HorizontalAlignment="Center">
                        <TextBlock Text="PhasOverlay never reads or touches Phasmophobia. Every timer and tracker is triggered manually by you."
                                   Foreground="#FF888888" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- STEP 2: THE BASICS -->
                <!-- Top-aligned: this step is the tallest, and centring made it bleed up into the header. -->
                <StackPanel x:Name="Step2" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="The Essentials" Foreground="White" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Every action is a keypress. The timers sit on F1-F7 so they never clash with your in-game gear slots, and evidence uses Shift + F1-F7:"
                               Foreground="#FFCCCCCC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,11" HorizontalAlignment="Center" MaxWidth="500"/>

                    <Border Background="#FF161618" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Padding="22,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F1" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Smudge timer" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F2" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Cooldown timer" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F3" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Hunt timer" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Tap ghost speed" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="O" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Evidence tracker" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>
                            <StackPanel x:Name="KeyRowClear" Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="0" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Clear everything" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>

                            <StackPanel x:Name="KeyRowSettings" Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Home" Style="{StaticResource KeyCapText}"/></Border>
                                <TextBlock Text="Open settings" Style="{StaticResource KeyRowLabel}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The behaviours a new user can't discover on their own -->
                    <Border Background="#FF161618" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Padding="20,9" Margin="0,8,0,0">
                        <TextBlock Foreground="#FFAAAAAA" FontSize="11.5" TextWrapping="Wrap" LineHeight="16">
                            <Run Foreground="#FFB455FF" FontWeight="Bold" Text="•"/><Run Text=" Timers only show while they're running, so the overlay stays out of your way until you need it."/><LineBreak/>
                            <Run Foreground="#FFB455FF" FontWeight="Bold" Text="•"/><Run Text=" Your clicks pass straight through it, so it never blocks the game underneath."/><LineBreak/>
                            <Run Foreground="#FFB455FF" FontWeight="Bold" Text="•"/><Run Text=" In the evidence tracker, click a box once to confirm it, twice to rule it out."/>
                        </TextBlock>
                    </Border>

                    <!-- Hands-on -->
                    <Border x:Name="TryItBox" Background="#14B455FF" BorderBrush="#40B455FF" BorderThickness="1" CornerRadius="8" Padding="16,9" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TryItText" Text="Give it a try! Press" Foreground="#FFDDDDDD" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="470"/>
                            <Border x:Name="TryItKey" Style="{StaticResource KeyCap}" Margin="10,0,10,0"><TextBlock Text="F3" Style="{StaticResource KeyCapText}"/></Border>
                            <TextBlock x:Name="TryItText2" Text="to start a Hunt timer" Foreground="#FFDDDDDD" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- STEP 3: PREFERENCES -->
                <StackPanel x:Name="Step3" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="Your setup" Foreground="White" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Tune it to your match. You can change all of this later from Settings (Home)."
                               Foreground="#FFCCCCCC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                    <Grid Width="520" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" x:Name="ColDifficulty"/>
                                    <ColumnDefinition Width="0" x:Name="ColCustomGap"/>
                                    <ColumnDefinition Width="0" x:Name="ColCustomDur"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DIFFICULTY" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox x:Name="CmbDifficulty" SelectionChanged="Difficulty_SelectionChanged">
                                        <ComboBoxItem Content="Amateur"/>
                                        <ComboBoxItem Content="Intermediate" IsSelected="True"/>
                                        <ComboBoxItem Content="Professional"/>
                                        <ComboBoxItem Content="Nightmare"/>
                                        <ComboBoxItem Content="Insanity"/>
                                        <ComboBoxItem x:Name="ItemWeekly" Content="Weekly" Visibility="Collapsed"/>
                                        <ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="PanelCustomDuration" Grid.Column="2" Visibility="Collapsed">
                                    <TextBlock Text="HUNT DURATION" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox x:Name="CmbCustomDuration" SelectionChanged="Setup_SelectionChanged">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="MAP SIZE" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CmbMap" Margin="0,0,0,18" SelectionChanged="Setup_SelectionChanged">
                                <ComboBoxItem Content="Small" IsSelected="True"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Large"/>
                            </ComboBox>

                            <TextBlock Text="GHOST SPEED" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CmbSpeed" Margin="0,0,0,18" SelectionChanged="Setup_SelectionChanged">
                                <ComboBoxItem Content="50% Speed"/>
                                <ComboBoxItem Content="75% Speed"/>
                                <ComboBoxItem Content="100% Speed" IsSelected="True"/>
                                <ComboBoxItem Content="125% Speed"/>
                                <ComboBoxItem Content="150% Speed"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OVERLAY POSITION" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CmbPosition" Margin="0,0,0,18" SelectionChanged="SldPosition_ValueChanged">
                                <ComboBoxItem Content="Top Left" IsSelected="True"/>
                                <ComboBoxItem Content="Top Centre"/>
                                <ComboBoxItem Content="Top Right"/>
                            </ComboBox>

                            <Grid>
                                <TextBlock Text="OVERLAY SIZE" Style="{StaticResource SettingLabel}"/>
                                <TextBlock x:Name="ScaleValueLabel" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldScale" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="SldScale_ValueChanged" Margin="0,0,0,18"/>

                            <Grid>
                                <TextBlock Text="BACKGROUND OPACITY" Style="{StaticResource SettingLabel}"/>
                                <TextBlock x:Name="OpacityValueLabel" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldOpacity" Minimum="0" Maximum="1" Value="0.8" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="SldOpacity_ValueChanged" Margin="0,0,0,18"/>

                            <TextBlock Text="DISPLAY MODE" Style="{StaticResource SettingLabel}"/>
                            <CheckBox x:Name="ChkPersistentOverlay" Content="Persistent Overlay" Style="{StaticResource ModernSwitch}" Click="PersistentMode_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <TextBlock x:Name="TxtProgress" Text="STEP 1 OF 3" Foreground="#FF55555A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="BtnContinue" Content="CONTINUE" Width="180" Height="40" Style="{StaticResource ModernButtonStyle}" Click="Continue_Click" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="BtnFinish" Content="FINISH SETUP" Width="180" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="Finish_Click" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
