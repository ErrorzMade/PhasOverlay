<Window x:Class="PhasOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModeRowName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModeGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6E6E76"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModeTrack" TargetType="Border">
            <Setter Property="Background" Value="#FF1C1C1F"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModeSeg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF8A8A92"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" CornerRadius="11" Background="Transparent" Padding="11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#FF2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#FFB455FF"/>
                                <Setter Property="Foreground" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Background" Value="#FF1C1C1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB455FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2D2D30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#FF3F3F46" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3E3E42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFB455FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2111112" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Margin="12" Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" BorderBrush="#FF252528" BorderThickness="0,0,0,1" Padding="30,25,30,20">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="PhasOverlay Settings" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <Border Height="3" Width="94" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource AccentUnderline}"/>
                    </StackPanel>
                    <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,25,30,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" x:Name="ColDifficulty"/>
                            <ColumnDefinition Width="0" x:Name="ColCustomGap"/>
                            <ColumnDefinition Width="0" x:Name="ColCustomDur"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DIFFICULTY" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CmbDifficulty" Focusable="False" FontSize="14" Padding="8,6" SelectionChanged="Difficulty_SelectionChanged">
                                <ComboBoxItem Content="Amateur"/>
                                <ComboBoxItem Content="Intermediate"/>
                                <ComboBoxItem Content="Professional"/>
                                <ComboBoxItem Content="Nightmare"/>
                                <ComboBoxItem Content="Insanity"/>
                                <ComboBoxItem x:Name="ItemWeekly" Content="Weekly" Visibility="Collapsed"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                            <!-- Shows the hunt-length tier a preset resolves to (Custom uses the combo instead). -->
                            <TextBlock x:Name="HuntTierLabel" Foreground="#FF888888" FontSize="11" FontWeight="SemiBold" Margin="2,6,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="PanelCustomDuration" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Text="HUNT DURATION" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="CmbCustomDuration" Focusable="False" FontSize="14" Padding="8,6" SelectionChanged="SilentUpdate_Trigger">
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MAP SIZE" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="MapCombo" Focusable="False" FontSize="14" Padding="8,6" SelectionChanged="SilentUpdate_Trigger">
                                <ComboBoxItem Content="Small"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Large"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GHOST SPEED" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="SpeedCombo" Focusable="False" FontSize="14" Padding="8,6" SelectionChanged="SilentUpdate_Trigger">
                                <ComboBoxItem Content="50% Speed"/>
                                <ComboBoxItem Content="75% Speed"/>
                                <ComboBoxItem Content="100% Speed"/>
                                <ComboBoxItem Content="125% Speed"/>
                                <ComboBoxItem Content="150% Speed"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="AUDIO SETTINGS" Style="{StaticResource SettingLabel}"/>
                    <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VolumeLabel" Text="Volume (100%)" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="95"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Grid.Column="2" Content="TEST" Style="{StaticResource ModernButton}" Width="50" Height="24" FontSize="11" Click="TestAudio_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="OVERLAY POSITION" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="CmbPosition" FontSize="14" Padding="8,6" Margin="0,0,0,20" SelectionChanged="PreviewUpdate_Trigger">
                        <ComboBoxItem Content="Top Left"/>
                        <ComboBoxItem Content="Top Centre"/>
                        <ComboBoxItem Content="Top Right"/>
                    </ComboBox>

                    <TextBlock x:Name="DisplayLabel" Text="DISPLAY SETTINGS" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="CmbDisplay" FontSize="14" Padding="8,6" Margin="0,0,0,16" SelectionChanged="Display_Changed"/>

                    <Grid>
                        <TextBlock Text="OVERLAY SIZE" Style="{StaticResource SettingLabel}"/>
                        <TextBlock x:Name="ScaleValueLabel" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Small" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="PreviewUpdate_Trigger"/>
                        <TextBlock Text="Large" Grid.Column="2" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="BACKGROUND OPACITY" Style="{StaticResource SettingLabel}"/>
                        <TextBlock x:Name="OpacityValueLabel" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Clear" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.8" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="PreviewUpdate_Trigger"/>
                        <TextBlock Text="Solid" Grid.Column="2" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="HOTKEYS" Style="{StaticResource SettingLabel}"/>
                    <Button Content="CONFIGURE HOTKEYS" Style="{StaticResource ModernButton}" Height="38" Margin="0,0,0,20" Click="OpenHotkeys_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="OVERLAY MODULES" Style="{StaticResource SettingLabel}"/>
                    <Button Content="CONFIGURE MODULES" Style="{StaticResource ModernButton}" Height="38" Margin="0,0,0,20" Click="OpenModules_Click"/>
                </StackPanel>

            </Grid>

            <Border Grid.Row="2" Background="Transparent" BorderBrush="#FF252528" BorderThickness="0,1,0,0" Padding="15" CornerRadius="0,0,8,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ModernButton}" Height="38" Width="180" Margin="0,0,10,0" Click="CloseButton_Click">
                            <TextBlock Text="CLOSE MENU"/>
                        </Button>
                        <Button Style="{StaticResource ModernButton}" Height="38" Width="180" Margin="10,0,0,0" Click="CloseOverlay_Click">
                            <TextBlock Text="EXIT OVERLAY" Foreground="#FFFF5555"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="VersionLabel" Foreground="#FF55555A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border x:Name="ModulesModalOverlay" Grid.RowSpan="3" Background="#D8000000" CornerRadius="8" Visibility="Collapsed" Panel.ZIndex="100" MouseLeftButtonDown="ModulesModalOverlay_MouseLeftButtonDown">
                <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="8" Width="520" Padding="30,24,30,26" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="ModalContent_MouseLeftButtonDown">
                    <StackPanel>

                        <Grid Margin="0,0,0,18">
                            <TextBlock Text="Modules" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,42,0">
                                <Button Content="ALL AUTO" Tag="Auto" Style="{StaticResource ModernButton}"
                                        Height="24" Width="80" FontSize="10" Margin="0,0,6,0" Click="ModulePreset_Click"/>
                                <Button Content="ALL ALWAYS" Tag="Always" Style="{StaticResource ModernButton}"
                                        Height="24" Width="90" FontSize="10" Click="ModulePreset_Click"/>
                            </StackPanel>
                            <Button Style="{StaticResource CloseButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseModules_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TIMERS" Style="{StaticResource ModeGroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Smudge" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbSmudgeOff" GroupName="ModSmudge" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbSmudgeAuto" GroupName="ModSmudge" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbSmudgeAlways" GroupName="ModSmudge" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Cooldown" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbCooldownOff" GroupName="ModCooldown" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbCooldownAuto" GroupName="ModCooldown" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbCooldownAlways" GroupName="ModCooldown" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Hunt" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbHuntOff" GroupName="ModHunt" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbHuntAuto" GroupName="ModHunt" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbHuntAlways" GroupName="ModHunt" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Obambo" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbObamboOff" GroupName="ModObambo" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbObamboAuto" GroupName="ModObambo" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbObamboAlways" GroupName="ModObambo" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Speed Tap" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbSpeedOff" GroupName="ModSpeed" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbSpeedAuto" GroupName="ModSpeed" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbSpeedAlways" GroupName="ModSpeed" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="MODIFIERS" Style="{StaticResource ModeGroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Blood Moon" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbBloodMoonAuto" GroupName="ModBloodMoon" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbBloodMoonAlways" GroupName="ModBloodMoon" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Cursed Hunt" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbCursedAuto" GroupName="ModCursed" Content="Auto Hide" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbCursedAlways" GroupName="ModCursed" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PANELS" Style="{StaticResource ModeGroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Evidence" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbEvidenceOff" GroupName="ModEvidence" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbEvidenceAlways" GroupName="ModEvidence" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Height="34">
                            <TextBlock Text="Possible Ghosts" Style="{StaticResource ModeRowName}"/>
                            <Border Style="{StaticResource ModeTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbGhostsOff" GroupName="ModGhosts" Content="Off" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                    <RadioButton x:Name="RbGhostsAlways" GroupName="ModGhosts" Content="Always Show" Style="{StaticResource ModeSeg}" Checked="ModuleMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="HotkeysModalOverlay" Grid.RowSpan="3" Background="#D8000000" CornerRadius="8" Visibility="Collapsed" Panel.ZIndex="100" MouseLeftButtonDown="HotkeysModalOverlay_MouseLeftButtonDown">
                <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="8" Width="550" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="ModalContent_MouseLeftButtonDown">
                    <StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Configure Hotkeys" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <RadioButton x:Name="TabMain" Grid.Column="2" Content="Main" Style="{StaticResource TabPillStyle}" GroupName="HotkeyTabs" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabEvidence" Grid.Column="3" Content="Evidence" Style="{StaticResource TabPillStyle}" GroupName="HotkeyTabs" Checked="Tab_Checked"/>

                            <Button Grid.Column="4" Style="{StaticResource CloseButtonStyle}" Width="30" Height="30" Margin="15,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseHotkeys_Click"/>
                        </Grid>

                        <TextBlock Text="Click a button below, then press any key on your keyboard to assign it to that action. Press ESC to cancel." Foreground="#FFAAAAAA" FontSize="13" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <Border Background="#FF2A2A2E" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <!-- MAIN HOTKEYS, grouped by purpose -->
                                <StackPanel x:Name="MainHotkeysGrid" Visibility="Visible">
                                    <StackPanel.Resources>
                                        <Style x:Key="BindGroupHeader" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFB455FF"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="2,9,0,3"/>
                                        </Style>
                                        <Style x:Key="BindRow" TargetType="Grid">
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </StackPanel.Resources>

                                    <TextBlock Text="TIMERS" Style="{StaticResource BindGroupHeader}" Margin="2,0,0,3"/>
                                    <Grid Style="{StaticResource BindRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" x:Name="BtnBindSmudge" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Smudge"/>
                                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBindCooldown" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Cooldown"/>
                                        <Button Grid.Row="1" Grid.Column="0" x:Name="BtnBindHunt" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Hunt"/>
                                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBindObambo" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Obambo"/>
                                    </Grid>

                                    <TextBlock Text="SPEED" Style="{StaticResource BindGroupHeader}"/>
                                    <Grid Style="{StaticResource BindRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnBindSpeedTap" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="SpeedTap"/>
                                        <Button Grid.Column="2" x:Name="BtnBindSpeedReset" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="SpeedReset"/>
                                    </Grid>

                                    <TextBlock Text="EVENTS" Style="{StaticResource BindGroupHeader}"/>
                                    <Grid Style="{StaticResource BindRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnBindBloodMoon" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="BloodMoon"/>
                                        <Button Grid.Column="2" x:Name="BtnBindCursedHunt" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="CursedHunt"/>
                                    </Grid>

                                    <TextBlock Text="WINDOWS &amp; UI" Style="{StaticResource BindGroupHeader}"/>
                                    <Grid Style="{StaticResource BindRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" x:Name="BtnBindSettings" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Settings"/>
                                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBindEvidence" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Evidence"/>
                                        <Button Grid.Row="1" Grid.Column="0" x:Name="BtnBindMap" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Map"/>
                                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBindToggleEv" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="ToggleEv"/>
                                        <Button Grid.Row="2" Grid.Column="0" x:Name="BtnBindMapHold" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="MapHold"/>
                                        <Button Grid.Row="2" Grid.Column="2" x:Name="BtnBindClear" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Clear"/>
                                    </Grid>
                                </StackPanel>

                                <!-- EVIDENCE HOTKEYS -->
                                <StackPanel x:Name="EvidenceHotkeysGrid" Visibility="Collapsed">
                                    <TextBlock Text="EVIDENCE TOGGLES" Foreground="#FFB455FF" FontSize="11" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" x:Name="BtnBindEv1" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev1"/>
                                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBindEv2" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev2"/>

                                        <Button Grid.Row="1" Grid.Column="0" x:Name="BtnBindEv3" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev3"/>
                                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBindEv4" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev4"/>

                                        <Button Grid.Row="2" Grid.Column="0" x:Name="BtnBindEv5" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev5"/>
                                        <Button Grid.Row="2" Grid.Column="2" x:Name="BtnBindEv6" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev6"/>

                                        <Button Grid.Row="3" Grid.Column="0" x:Name="BtnBindEv7" Style="{StaticResource HotkeyButton}" Click="Bind_Click" Tag="Ev7"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="RESET TO DEFAULT" Style="{StaticResource ModernButton}" Height="38" Click="ResetBinds_Click"/>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>