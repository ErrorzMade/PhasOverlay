<Window x:Class="PhasOverlay.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#FF3F3F46" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3E3E42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFB455FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#33B455FF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2111112" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Margin="12" Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="#FF252528" BorderThickness="0,0,0,1" Padding="28,22,28,18">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Update Available" Foreground="White" FontSize="21" FontWeight="Bold"/>
                        <Border Height="3" Width="80" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource AccentUnderline}"/>
                    </StackPanel>
                    <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CloseButtonStyle}" Click="Later_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,22,28,18">
                <TextBlock x:Name="VersionLine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>

                <Border x:Name="NotesCard" Visibility="Collapsed" Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                    <TextBlock x:Name="NotesText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Your settings and tracker data are kept when you update."
                           Foreground="{StaticResource TextFaintBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Background="Transparent" BorderBrush="#FF252528" BorderThickness="0,1,0,0" Padding="15" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="SKIP THIS VERSION" Style="{StaticResource ModernButton}"
                            Height="34" Width="150" FontSize="11" Click="Skip_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="LATER" Style="{StaticResource ModernButton}" Height="34" Width="80" Margin="0,0,10,0" Click="Later_Click"/>
                        <Button Content="DOWNLOAD" Style="{StaticResource AccentButton}" Height="34" Width="120" Click="Download_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
