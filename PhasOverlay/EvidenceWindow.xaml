<Window x:Class="PhasOverlay.EvidenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence Tracker" Height="800" Width="1180"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="AnimatedModalStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="40"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=GhostModalOverlay}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PopInAnimation">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="40" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PopInAnimation"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsThreeState" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BgBorder" Width="36" Height="20" CornerRadius="10" Background="#FF2A2A2E" HorizontalAlignment="Left"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FFAAAAAA" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FF3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FFB455FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF151515"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="19,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FFFF5555"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="11,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FF2A2A2E"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFAAAAAA"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChecklistSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BgBorder" Width="36" Height="20" CornerRadius="10" Background="#FF2A2A2E" HorizontalAlignment="Left"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FFAAAAAA" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FF3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#FFB455FF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF151515"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="19,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedPill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Background" Value="#FF1C1C1F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB455FF"/>
                                <Setter Property="Foreground" Value="#FF151515"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#FF3F3F46" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF3E3E42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF55555A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="4" Padding="6,0">
                            <TextBlock Text="[+]" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFB455FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SpeedOptionCardTemplate">
            <Grid>
                <Button Content="{Binding Display}" CommandParameter="{Binding Value}" Click="PlaySpeed_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFB455FF"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding Display}" Foreground="#FFB455FF" FontSize="11" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClickable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SpeedOptionModalTemplate">
            <Grid>
                <Button Content="{Binding Display}" CommandParameter="{Binding Value}" Click="PlaySpeed_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFB455FF"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#FFFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding Display}" Foreground="#FFB455FF" FontSize="16" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClickable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#F2111112" BorderBrush="#FF252528" BorderThickness="1" CornerRadius="8" Margin="12" Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#FF252528" BorderThickness="0,0,1,0" Padding="20,30,20,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Evidence" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <Border Height="3" Width="64" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource AccentUnderline}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="30,30,30,10">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ghosts" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="12,4,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="GhostCountText" Text="24 possible" Foreground="#FFAAAAAA" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <Border Height="3" Width="54" Margin="0,8,0,0" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource AccentUnderline}"/>
                        </StackPanel>

                        <ToggleButton x:Name="BtnMatchSetup" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,42,0" Height="30" Cursor="Hand" Checked="MatchToggle_Changed" Unchecked="MatchToggle_Changed">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="mb" Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="15" Padding="12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="gearIcon" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" Fill="#FFCCCCCC"
                                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.49.49 0 0 0-.48-.41h-3.84a.49.49 0 0 0-.47.41l-.36 2.54a7.03 7.03 0 0 0-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.49.49 0 0 0 .12.61l2.03 1.58c-.05.3-.07.62-.07.94 0 .32.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z"/>
                                            <TextBlock x:Name="gearLabel" Text="Game Settings" FontSize="11" FontWeight="Bold" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="mb" Property="Background" Value="#FF2D2D30"/>
                                            <Setter TargetName="mb" Property="BorderBrush" Value="#FFB455FF"/>
                                            <Setter TargetName="gearIcon" Property="Fill" Value="White"/>
                                            <Setter TargetName="gearLabel" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="mb" Property="Background" Value="#FFB455FF"/>
                                            <Setter TargetName="mb" Property="BorderBrush" Value="#FFB455FF"/>
                                            <Setter TargetName="gearIcon" Property="Fill" Value="White"/>
                                            <Setter TargetName="gearLabel" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CloseButtonStyle}" Click="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#FF252528" BorderThickness="0,0,1,0" Padding="20,10,20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <CheckBox x:Name="ChkEmf" Content="EMF Level 5" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkDots" Content="D.O.T.S Projector" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkUv" Content="Ultraviolet" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkFreezing" Content="Freezing Temperatures" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkOrb" Content="Ghost Orb" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkWriting" Content="Ghost Writing" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>
                            <CheckBox x:Name="ChkBox" Content="Spirit Box" IsChecked="{x:Null}" Style="{StaticResource ModernSwitch}" PreviewMouseLeftButtonDown="Evidence_PreviewMouseLeftButtonDown"/>

                            <TextBlock Text="Hunt" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,15,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="TglHuntVeryEarly" Grid.Column="0" Height="44" Style="{StaticResource SegmentedPill}" Click="HuntPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Very Early" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&gt;70%" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TglHuntEarly" Grid.Column="1" Height="44" Style="{StaticResource SegmentedPill}" Click="HuntPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Early" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&gt;50%" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TglHuntNormal" Grid.Column="2" Height="44" Style="{StaticResource SegmentedPill}" Click="HuntPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Normal" HorizontalAlignment="Center"/>
                                        <TextBlock Text="50%" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TglHuntLate" Grid.Column="3" Height="44" Style="{StaticResource SegmentedPill}" Click="HuntPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Late" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&lt;50%" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <TextBlock Text="Speed" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,15,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="TglSpeedSlow" Grid.Column="0" Height="44" Style="{StaticResource SegmentedPill}" Click="SpeedPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Slow" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&lt;1.7m/s" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TglSpeedNormal" Grid.Column="1" Height="44" Style="{StaticResource SegmentedPill}" Click="SpeedPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Normal" HorizontalAlignment="Center"/>
                                        <TextBlock Text="1.7m/s" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TglSpeedFast" Grid.Column="2" Height="44" Style="{StaticResource SegmentedPill}" Click="SpeedPill_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fast" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&gt;1.7m/s" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <TextBlock Text="Evidence Given" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,15,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="TglEv0" Grid.Column="0" Content="0" Style="{StaticResource SegmentedPill}" Click="EvCount_Click"/>
                                <ToggleButton x:Name="TglEv1" Grid.Column="1" Content="1" Style="{StaticResource SegmentedPill}" Click="EvCount_Click"/>
                                <ToggleButton x:Name="TglEv2" Grid.Column="2" Content="2" Style="{StaticResource SegmentedPill}" Click="EvCount_Click"/>
                                <ToggleButton x:Name="TglEv3" Grid.Column="3" Content="3" IsChecked="True" Style="{StaticResource SegmentedPill}" Click="EvCount_Click"/>
                            </Grid>

                            <Button Content="RESET TRACKER" Style="{StaticResource ModernButton}" Height="38" Margin="0,25,0,0" Click="ResetTracker_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Foreground="#FF55555A" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            Credit to <Hyperlink NavigateUri="https://tybayn.github.io/phasmo-cheat-sheet/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#FFB455FF">tybayn.github.io/phasmo-cheat-sheet/</Hyperlink> for some of the ghost data.
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="StaleDataBar" Grid.Row="0" Background="#22FF5555" BorderBrush="#55FF5555" BorderThickness="0,0,0,1"
                            Padding="25,10,25,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠" Foreground="{StaticResource DangerBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StaleDataText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="StaleDataButton" Content="GET UPDATE" Style="{StaticResource ModernButton}" Height="24" Width="100"
                                    FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center" Click="StaleData_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Match setup lives here (not the left panel) so it never squeezes the evidence controls. -->
                    <Border x:Name="MatchBar" Grid.Row="1" Background="Transparent" BorderBrush="#FF252528" BorderThickness="0,0,0,1" Padding="25,12,25,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Width="150" Margin="0,0,12,0">
                                <TextBlock Text="DIFFICULTY" Foreground="#FF888888" FontSize="10" FontWeight="Bold" Margin="2,0,0,3"/>
                                <ComboBox x:Name="CtxDifficulty" FontSize="12" Padding="8,4" SelectionChanged="CtxMatch_Changed">
                                    <ComboBoxItem Content="Amateur"/>
                                    <ComboBoxItem Content="Intermediate"/>
                                    <ComboBoxItem Content="Professional"/>
                                    <ComboBoxItem Content="Nightmare"/>
                                    <ComboBoxItem Content="Insanity"/>
                                    <ComboBoxItem x:Name="ItemWeekly" Content="Weekly" Visibility="Collapsed"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="MAP SIZE" Foreground="#FF888888" FontSize="10" FontWeight="Bold" Margin="2,0,0,3"/>
                                <ComboBox x:Name="CtxMap" FontSize="12" Padding="8,4" SelectionChanged="CtxMatch_Changed">
                                    <ComboBoxItem Content="Small"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Large"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="110" Margin="0,0,12,0">
                                <TextBlock Text="HUNT" Foreground="#FF888888" FontSize="10" FontWeight="Bold" Margin="2,0,0,3"/>
                                <ComboBox x:Name="CtxHunt" FontSize="12" Padding="8,4" SelectionChanged="CtxMatch_Changed">
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Med"/>
                                    <ComboBoxItem Content="High"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="GHOST SPEED" Foreground="#FF888888" FontSize="10" FontWeight="Bold" Margin="2,0,0,3"/>
                                <ComboBox x:Name="CtxSpeed" FontSize="12" Padding="8,4" SelectionChanged="CtxMatch_Changed">
                                    <ComboBoxItem Content="50%"/>
                                    <ComboBoxItem Content="75%"/>
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="125%"/>
                                    <ComboBoxItem Content="150%"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="GhostScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="25,10,25,25">
                    <ItemsControl x:Name="GhostItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5" Cursor="Hand" MouseLeftButtonDown="GhostCard_MouseLeftButtonDown">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" x:Name="GhostName" Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <Button Grid.Column="1" Style="{StaticResource ExpandButtonStyle}" HorizontalAlignment="Right" Click="ExpandGhost_Click"/>
                                        </Grid>

                                        <!-- Evidence gets its own row: the full-word tags don't fit beside the
                                             ghost name, and a WrapPanel keeps them readable if they ever overflow. -->
                                        <ItemsControl ItemsSource="{Binding EvidenceIcons}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Compact text tag; the full evidence name is on the tooltip. -->
                                                        <Border Margin="0,0,3,0" VerticalAlignment="Center" CornerRadius="3"
                                                                Padding="4,1" ToolTip="{Binding FullName}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FF2A2A2E"/>
                                                                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                                                    <Setter Property="BorderBrush" Value="#FFB455FF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsForcedVisible}" Value="True">
                                                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="1">
                                                                            <Setter Property="Background" Value="#33B455FF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="2">
                                                                            <Setter Property="Background" Value="#33FF5555"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="1">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="2">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Speed: " Foreground="#FFAAAAAA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ItemsControl ItemsSource="{Binding Speeds}" ItemTemplate="{StaticResource SpeedOptionCardTemplate}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <TextBlock Text="Sanity: " Foreground="#FFAAAAAA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Sanity}" Foreground="#FFFF5555" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding TruncatedTell}" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSpeedHighlighted}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                        <Setter TargetName="CardBorder" Property="Background" Value="#FF3F3F46"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding CardState}" Value="1">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#FF2D2D30"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB455FF"/>
                                        <Setter TargetName="GhostName" Property="Foreground" Value="#FFB455FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CardState}" Value="2">
                                        <Setter TargetName="CardBorder" Property="Opacity" Value="0.3"/>
                                        <Setter TargetName="GhostName" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border x:Name="GhostModalOverlay" Grid.RowSpan="2" Background="#D8000000" CornerRadius="8" Visibility="Collapsed" MouseLeftButtonDown="GhostModalOverlay_MouseLeftButtonDown">
                <Border x:Name="GhostModalContent" Style="{StaticResource AnimatedModalStyle}" Background="#FF131317" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="10" Width="1000" Height="650" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="ModalContent_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="ModalGhostName" Text="Ghost Name" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Border Height="2" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFB455FF" Offset="0.0"/>
                                            <GradientStop Color="#00B455FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource CloseButtonStyle}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseModal_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Speed: " Foreground="#FFAAAAAA" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ItemsControl x:Name="ModalGhostSpeedControl" ItemTemplate="{StaticResource SpeedOptionModalTemplate}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sanity: " Foreground="#FFAAAAAA" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ModalGhostSanity" Text="-" Foreground="#FFFF5555" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#14141E" BorderThickness="1" CornerRadius="6" Padding="15,10">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB455FF" Offset="0.0"/>
                                        <GradientStop Color="#33B455FF" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Evidence: " Foreground="#FFB455FF" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="ModalGhostEvidence" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="ModalGhostTellScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,25,0">
                                <TextBlock x:Name="ModalGhostTell" Text="Ghost tell..." Foreground="#E0E0E0" FontSize="16" TextWrapping="Wrap" LineHeight="28"/>
                            </ScrollViewer>

                            <Border x:Name="RightPanelBorder" Grid.Column="1" Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="8" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="BehaviorsTitle" Grid.Row="0" Text="BEHAVIOURS" Foreground="#FFB455FF" FontSize="13" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <ScrollViewer x:Name="BehaviorsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="Width" Value="4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Background="{TemplateBinding Background}">
                                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                    <Track.Thumb>
                                                                        <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsControl x:Name="ModalBehaviorControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="• " Foreground="#FFB455FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Top"/>
                                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" LineHeight="18">
                                                                <Run Text="{Binding Prefix}" Foreground="#FFB455FF" FontWeight="SemiBold"/>
                                                                <Run Text="{Binding Description}" Foreground="#CCCCCC"/>
                                                            </TextBlock>
                                                        </Grid>
                                                        <Button Content="{Binding ActionText}" CommandParameter="{Binding}" Click="BehaviorAction_Click" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="1">
                                                                            <Setter Property="Foreground" Value="#FFB455FF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="2">
                                                                            <Setter Property="Foreground" Value="#FFFF5555"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border x:Name="GraphDivider" Grid.Row="2" Height="1" Background="#FFB455FF" Margin="0,15,0,15" Opacity="0.5"/>

                                    <Grid x:Name="SpeedGraphContainer" Grid.Row="3" Height="140">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="LOS SPEEDUP" Foreground="#FFB455FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnPlayGraph" HorizontalAlignment="Right" VerticalAlignment="Center" Width="22" Height="22" Cursor="Hand" Click="PlayGraph_Click" ToolTip="Hear the speed ramp. Footsteps accelerate along the curve">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="pb" Background="#FF2A2A2E" CornerRadius="11">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="pb" Property="Background" Value="#FF3F3F46"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Path x:Name="PlayIcon" Width="9" Height="9" Stretch="Uniform" Fill="#FFB455FF" Data="M8,5 L19,12 L8,19 Z"/>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1,0,0,1" Margin="30,5,10,20" />

                                            <TextBlock Text="4 m/s" Foreground="#FF55555A" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                                            <TextBlock Text="0 m/s" Foreground="#FF55555A" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,14"/>

                                            <TextBlock Text="0s" Foreground="#FF55555A" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,0"/>
                                            <TextBlock Text="15s" Foreground="#FF55555A" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,0,0"/>

                                            <Grid Margin="30,5,10,20" IsHitTestVisible="False">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" BorderBrush="#FF2A2A2E" BorderThickness="0,0,0,1"/>
                                                <Border Grid.Row="1" BorderBrush="#FF2A2A2E" BorderThickness="0,0,0,1"/>
                                                <Border Grid.Row="2" BorderBrush="#FF2A2A2E" BorderThickness="0,0,0,1"/>
                                            </Grid>

                                            <Canvas x:Name="GraphCanvas" Margin="30,5,10,20" Background="Transparent"
                                                    MouseMove="GraphCanvas_MouseMove" MouseLeave="GraphCanvas_MouseLeave" SizeChanged="GraphCanvas_SizeChanged">

                                                <Polygon x:Name="SpeedFill">
                                                    <Polygon.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#59B455FF" Offset="0"/>
                                                            <GradientStop Color="#14B455FF" Offset="0.7"/>
                                                            <GradientStop Color="#00B455FF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polygon.Fill>
                                                </Polygon>

                                                <Polyline x:Name="SpeedCurve" Stroke="#FFB455FF" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Polyline.Effect>
                                                        <DropShadowEffect Color="#FFB455FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                                    </Polyline.Effect>
                                                </Polyline>

                                                <Ellipse x:Name="EndPoint" Width="9" Height="9" Fill="#FFB455FF" Stroke="White" StrokeThickness="1.5" Margin="-4.5,-4.5,0,0" IsHitTestVisible="False">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#FFB455FF" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <Line x:Name="HoverLine" Stroke="White" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" Y1="0" Y2="{Binding ActualHeight, ElementName=GraphCanvas}" />
                                                <Ellipse x:Name="HoverPoint" Width="8" Height="8" Fill="White" Margin="-4,-4,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>

                                                <Border x:Name="HoverInfoBox" Background="#F2131317" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,4" Visibility="Collapsed" IsHitTestVisible="False">
                                                    <StackPanel>
                                                        <TextBlock x:Name="HoverTimeText" Foreground="#FFAAAAAA" FontSize="10" />
                                                        <TextBlock x:Name="HoverSpeedText" Foreground="#FFB455FF" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>