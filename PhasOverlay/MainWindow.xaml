<Window x:Class="PhasOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual" Left="0" Top="0">

    <Window.Resources>
        <Storyboard x:Key="PulseRedAnim">
            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                            To="#FFFF5555" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="2x"/>
        </Storyboard>
        
        <Style x:Key="TimerTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <SolidColorBrush x:Key="SharedBgBrush" x:Name="BgBrush" Color="Black" Opacity="0.8"/>

        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1" Margin="0,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- TOP CENTER PANEL: TIMERS & MODIFIERS -->
        <!-- Always click-through: nothing here is interactive and clicks must reach the game. -->
        <Border x:Name="TopCenterBorder" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,10,0,0" Effect="{StaticResource PanelShadow}">
            <Border.Background>
                <SolidColorBrush x:Name="BgBrush" Color="Black" Opacity="0.8"/>
            </Border.Background>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="TimersPanel" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>

                    <StackPanel x:Name="ModSmudge" MinWidth="110" Margin="10,0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="SmudgeTitle" Text="SMUDGE" Style="{StaticResource TimerTitleStyle}"/>
                        <TextBlock x:Name="SmudgeText" Text="0:00" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="ModCooldown" MinWidth="110" Margin="10,0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="CooldownTitle" Text="COOLDOWN" Style="{StaticResource TimerTitleStyle}"/>
                        <TextBlock x:Name="CooldownText" Text="0:00" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="ModHunt" MinWidth="110" Margin="10,0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="HuntTitle" Text="HUNT" Style="{StaticResource TimerTitleStyle}"/>
                        <TextBlock x:Name="HuntText" Text="0:00" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="ModObambo" MinWidth="110" Margin="10,0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="ObamboLabel" Text="OBAMBO" Style="{StaticResource TimerTitleStyle}"/>
                        <TextBlock x:Name="ObamboText" Text="0:00" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="ModSpeed" MinWidth="140" Margin="10,0">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="SpeedLabel" Text="SPEED" Style="{StaticResource TimerTitleStyle}"/>
                        <TextBlock x:Name="SpeedText" Text="-" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- MODIFIERS -->
                <Border x:Name="RightColumnBorder" BorderBrush="#FF2A2A2E" BorderThickness="1,0,0,0" Margin="15,0,0,0" Padding="15,0,0,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="ModBloodMoon" Margin="5,0">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Path x:Name="BloodMoonIcon" Width="26" Height="26" Stretch="Uniform" Fill="#FF2A2A2E" Data="M12.74,2.32 C12.28,2.2 11.8,2.15 11.3,2.15 C6.08,2.15 1.85,6.38 1.85,11.6 C1.85,16.82 6.08,21.05 11.3,21.05 C16.52,21.05 20.75,16.82 20.75,11.6 C20.75,10.64 20.59,9.7 20.31,8.82 C19.64,11.36 17.3,13.25 14.5,13.25 C11.32,13.25 8.75,10.68 8.75,7.5 C8.75,4.98 10.37,2.83 12.74,2.32 Z"/>
                        </StackPanel>
                        
                        <StackPanel x:Name="ModCursed" Margin="5,0">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Path x:Name="CursedIcon" Width="26" Height="26" Stretch="Uniform" Fill="#FF2A2A2E" Data="M 12 2 C 7.5817 2 4 5.5817 4 10 C 4 12.3023 4.97495 14.3725 6.51609 15.8242 L 6 21 C 6 21.5523 6.44772 22 7 22 L 10 22 C 10 21.4477 10.4477 21 11 21 L 13 21 C 13.5523 21 14 21.4477 14 22 L 17 22 C 17.5523 22 18 21.5523 18 21 L 17.4839 15.8242 C 19.025 14.3725 20 12.3023 20 10 C 20 5.5817 16.4183 2 12 2 z M 8.5 9 C 9.32843 9 10 9.67157 10 10.5 C 10 11.3284 9.32843 12 8.5 12 C 7.67157 12 7 11.3284 7 10.5 C 7 9.67157 7.67157 9 8.5 9 z M 15.5 9 C 16.3284 9 17 9.67157 17 10.5 C 17 11.3284 16.3284 12 15.5 12 C 14.6716 12 14 11.3284 14 10.5 C 14 9.67157 14.6716 9 15.5 9 z M 11 15 L 13 15 L 13 17 L 11 17 L 11 15 z"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- RIGHT SIDE PANEL: EVIDENCE -->
        <Border x:Name="EvidenceColumnBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding Background, ElementName=TopCenterBorder}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="20" MinWidth="160" Margin="0,10,15,0" Effect="{StaticResource PanelShadow}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Shared header row: aligned titles + one continuous underline across both -->
                <TextBlock x:Name="HdrEvidence" Grid.Row="0" Grid.Column="0" Text="EVIDENCE" Style="{StaticResource TimerTitleStyle}" HorizontalAlignment="Left" Margin="0,0,15,0"/>
                <TextBlock x:Name="HdrGhosts" Grid.Row="0" Grid.Column="1" Text="POSSIBLE GHOSTS" Style="{StaticResource TimerTitleStyle}" HorizontalAlignment="Left" Margin="0"/>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="2" Margin="0,4,0,12" CornerRadius="1" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFB455FF" Offset="0"/>
                            <GradientStop Color="#FFB455FF" Offset="0.7"/>
                            <GradientStop Color="#00B455FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel x:Name="ModEvidence" Grid.Row="2" Grid.Column="0" Margin="0,0,15,0">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="Ev1Text" Text="EMF Level 5" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev2Text" Text="D.O.T.S Projector" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev3Text" Text="Ultraviolet" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev4Text" Text="Freezing Temps" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev5Text" Text="Ghost Orb" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev6Text" Text="Ghost Writing" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="Ev7Text" Text="Spirit Box" Foreground="#FF55555A" FontWeight="Bold" FontSize="13" Margin="0,3"/>
                </StackPanel>

                <StackPanel x:Name="ModGhosts" Grid.Row="2" Grid.Column="1" Width="220">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <ScrollViewer x:Name="OverlayGhostScroller" MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Width" Value="3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="{TemplateBinding Background}">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#FF3F3F46" CornerRadius="1"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="OverlayGhostList" Orientation="Vertical"/>
                    </ScrollViewer>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>