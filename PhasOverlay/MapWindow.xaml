<Window x:Class="PhasOverlay.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maps" Height="900" Width="1120"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="&#10005;" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackSquareButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6" Background="#FF1C1C1F" BorderBrush="#FF2A2A2E" BorderThickness="1">
                            <TextBlock x:Name="arrow" Text="&#8592;" Foreground="#FFCCCCCC" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bg" Property="Background" Value="#FF2D2D30"/>
                                <Setter TargetName="arrow" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Evidence window's segmented pill: purple with dark text when selected. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="seg" CornerRadius="6" Background="Transparent" Padding="12,7">
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}" Foreground="#FFAAAAAA"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#FF2D2D30"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="seg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#FF151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="zb" Background="Transparent">
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}" Foreground="#FFCCCCCC"
                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="zb" Property="Background" Value="#FF2D2D30"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="zb" Property="Background" Value="Transparent"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="#FF55555A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailTag" TargetType="Border">
            <Setter Property="Background" Value="#FF2A2A2E"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SwitcherLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- A landmark, never clickable, so it lets a drag on the plan start through it. -->
        <Style x:Key="PowerBoxMarker" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Width="17" Height="17" CornerRadius="3"
                                    Background="{StaticResource PowerBoxFillBrush}" BorderBrush="{StaticResource PowerBoxBrush}" BorderThickness="1.5"/>
                            <Path Fill="{StaticResource PowerBoxBrush}" Stretch="Uniform" Width="6" Height="10"
                                  Data="M 6,0 L 0,7.6 L 3.6,7.6 L 2.4,14 L 9,6.2 L 5,6.2 Z"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A possession with no icon yet, so one added in data alone is still visible. -->
        <Style x:Key="MarkerButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="dot" Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                     Stroke="#FF0B0B0D" StrokeThickness="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Width" Value="11"/>
                                <Setter TargetName="dot" Property="Height" Value="11"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The icon is a pre-rendered bitmap in Tag with its glow, wider than the hit area. The negative
             margin keeps its layout size inside the button, or WPF crops it from the top left. -->
        <Style x:Key="PossessionMarker" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Image x:Name="icon" Width="46" Height="46" Margin="-3" Stretch="Fill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="icon" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.18" ScaleY="1.18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MapCardButton" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="0,0,12,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="6" Background="#FF1C1C1F"
                                BorderBrush="#FF2A2A2E" BorderThickness="1" SnapsToDevicePixels="True">
                            <StackPanel>
                                <Grid Height="90">
                                    <Grid.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Background="Black" CornerRadius="5,5,0,0" Width="158" Height="90"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Grid.OpacityMask>

                                    <Image x:Name="CardThumb" Source="{Binding Thumb}" Stretch="UniformToFill"/>

                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#B31C1C1F" Offset="0"/>
                                                <GradientStop Color="#001C1C1F" Offset="0.6"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Margin="10,7,10,10">
                                    <TextBlock x:Name="CardName" Text="{Binding Name}" Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               TextWrapping="Wrap" MinHeight="32"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Shell" Property="Background" Value="#FF222226"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Shell" Property="Background" Value="#FF222226"/>
                            </Trigger>
                            <!-- Last, so a map with no plan cannot light up under the cursor. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Shell" Property="Background" Value="#FF161618"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FF232326"/>
                                <Setter TargetName="CardName" Property="Foreground" Value="#FF6C6C72"/>
                                <!-- Gray32Float converts in linear light, so the grey reads brighter than the colour cards without this. -->
                                <Setter TargetName="CardThumb" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MapCardTemplate">
            <Button Style="{StaticResource MapCardButton}" Click="MapCard_Click"
                    IsEnabled="{Binding HasPlan}"
                    AutomationProperties.Name="{Binding Name}"/>
        </DataTemplate>

        <!-- Only ever on screen when a download is waiting for a restart. -->
        <Style x:Key="UpdateTag" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="BorderBrush" Value="#59B455FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <!-- Optically centred on the title's cap height, not its line box. -->
            <Setter Property="Margin" Value="12,3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UpdateTagText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2111112" CornerRadius="8" BorderBrush="#FF2A2A2E"
            BorderThickness="1" Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="#FF252528" BorderThickness="0,0,0,1" Padding="30,26,30,18">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Maps" Foreground="White" FontSize="24" FontWeight="Bold"/>
                            <Border x:Name="PickerUpdateTag" Style="{StaticResource UpdateTag}">
                                <TextBlock Text="MAP UPDATE READY, RESTART TO APPLY" Style="{StaticResource UpdateTagText}"/>
                            </Border>
                        </StackPanel>
                        <Border Height="3" Width="50" Margin="0,8,0,0" CornerRadius="1.5"
                                HorizontalAlignment="Left" Background="{StaticResource AccentUnderline}"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource CloseButtonStyle}" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- In the title bar so it never covers a map card or the plan. -->
            <Border x:Name="TutorialCoach" Grid.Row="0" Visibility="Collapsed" Panel.ZIndex="50"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="520" Margin="0,0,76,0"
                    Background="#FA17171B" BorderBrush="#FFB455FF" BorderThickness="1" CornerRadius="9"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#33B455FF" BorderBrush="#66B455FF" BorderThickness="1"
                            CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TutorialStepText" Foreground="#FFB455FF" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TutorialTitle" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TutorialBody" Foreground="#FFBBBBBB" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PICKER -->
            <Grid Grid.Row="1" x:Name="PickerView" Margin="30,24,16,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SMALL" Style="{StaticResource GroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="ListSmall" ItemTemplate="{StaticResource MapCardTemplate}" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Margin="0,0,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MEDIUM" Style="{StaticResource GroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="ListMedium" ItemTemplate="{StaticResource MapCardTemplate}" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Margin="0,0,14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LARGE" Style="{StaticResource GroupLabel}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" Height="1" Background="#FF252528" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="ListLarge" ItemTemplate="{StaticResource MapCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyNotice" Visibility="Collapsed" Margin="2,10,0,0"
                                   Foreground="#FFAAAAAA" FontSize="12"
                                   Text="Maps could not be loaded."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- DETAIL -->
            <Grid Grid.Row="1" x:Name="DetailView" Margin="30,18,30,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource BackSquareButton}" Click="Back_Click" AutomationProperties.Name="Back"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource DetailTag}">
                                <TextBlock x:Name="DetailSizeText" Foreground="#FFCCCCCC" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DetailName" Foreground="White" FontSize="20" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0,12,2"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionLabel" Text="VARIATION" Style="{StaticResource SwitcherLabel}" Visibility="Collapsed"/>
                        <Border x:Name="VersionSegment" Visibility="Collapsed" Background="#FF1C1C1F"
                                BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel x:Name="VersionBar" Orientation="Horizontal"/>
                        </Border>
                        <TextBlock x:Name="FloorLabel" Text="FLOOR" Style="{StaticResource SwitcherLabel}" Margin="16,0,8,0" Visibility="Collapsed"/>
                        <Border x:Name="FloorSegment" Visibility="Collapsed" Background="#FF1C1C1F"
                                BorderBrush="#FF2A2A2E" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel x:Name="FloorBar" Orientation="Horizontal"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="6" Background="#FF1C1C1F"
                        BorderBrush="#FF2A2A2E" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="PlanViewport" Background="Transparent" ClipToBounds="True"
                                SizeChanged="PlanViewport_SizeChanged"
                                MouseLeftButtonDown="Plan_MouseLeftButtonDown"
                                MouseLeftButtonUp="Plan_MouseLeftButtonUp"
                                MouseMove="Plan_MouseMove"
                                MouseWheel="Plan_MouseWheel">
                            <Grid>
                                <Canvas x:Name="PlanCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PlanScale"/>
                                            <TranslateTransform x:Name="PlanPan"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Image x:Name="PlanImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Canvas>
                                <Canvas x:Name="MarkerLayer"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NoPlanNotice" Text="Not added yet" Foreground="#FFAAAAAA"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Border Grid.Row="1" x:Name="StatusStrip" Visibility="Collapsed" Height="42"
                                BorderBrush="#FF2A2A2E" BorderThickness="0,1,0,0" Padding="16,0,10,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="PossessionKey" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="18" Background="#FF34343A" Margin="2,0,14,0" VerticalAlignment="Center"/>
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Border Width="13" Height="13" CornerRadius="2.5" Background="{StaticResource PowerBoxFillBrush}"
                                                BorderBrush="{StaticResource PowerBoxBrush}" BorderThickness="1.2"/>
                                        <Path Fill="{StaticResource PowerBoxBrush}" Stretch="Uniform" Width="4.5" Height="7.5"
                                              Data="M 6,0 L 0,7.6 L 3.6,7.6 L 2.4,14 L 9,6.2 L 5,6.2 Z"/>
                                    </Grid>
                                    <TextBlock Text="Power Box" Foreground="#FFAAAAAA" FontSize="11" FontWeight="SemiBold"
                                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#FF232327" BorderBrush="#FF34343A" BorderThickness="1" CornerRadius="5" Height="26">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ZoomOutButton" Style="{StaticResource ZoomButton}" Content="&#8722;"
                                                    Click="ZoomOut_Click" AutomationProperties.Name="Zoom out"/>
                                            <Border Width="1" Background="#FF34343A"/>
                                            <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" Foreground="#FFCCCCCC"
                                                       FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Width="1" Background="#FF34343A"/>
                                            <Button x:Name="ZoomInButton" Style="{StaticResource ZoomButton}" Content="+"
                                                    Click="ZoomIn_Click" AutomationProperties.Name="Zoom in"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ShotPopover" Visibility="Collapsed" Background="#F21A1A1D"
                                CornerRadius="6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"
                                MouseLeftButtonDown="ShotPopover_Click" Cursor="Hand"
                                Effect="{StaticResource PanelShadow}">
                            <StackPanel>
                                <Image x:Name="ShotImage" MaxWidth="620" MaxHeight="360" Stretch="Uniform"/>
                                <TextBlock x:Name="ShotTitle" Foreground="White" FontSize="13" FontWeight="Bold" Margin="2,9,2,0"/>
                                <TextBlock x:Name="ShotRoom" Foreground="#FF888888" FontSize="11" Margin="2,3,2,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
